{
  "manifest_version": 3,
  "name": "Pinterest Cleaner",
  "version": "2.0.0",
  "description": "Entfernt Werbung und Promo-Pins auf Pinterest, bevor sie gerendert werden – die echten Pins rücken lückenlos zusammen.",
  "permissions": ["storage"],
  "host_permissions": [
    "*://*.pinterest.com/*",
    "*://*.pinterest.de/*",
    "*://*.pinterest.at/*",
    "*://*.pinterest.ch/*",
    "*://*.pinterest.co.uk/*",
    "*://*.pinterest.fr/*",
    "*://*.pinterest.es/*",
    "*://*.pinterest.it/*",
    "*://*.pinterest.nl/*",
    "*://*.pinterest.se/*",
    "*://*.pinterest.dk/*",
    "*://*.pinterest.pt/*",
    "*://*.pinterest.ie/*",
    "*://*.pinterest.ca/*",
    "*://*.pinterest.com.au/*",
    "*://*.pinterest.nz/*",
    "*://*.pinterest.com.mx/*"
  ],
  "action": {
    "default_title": "Pinterest Cleaner",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.pinterest.com/*",
        "*://*.pinterest.de/*",
        "*://*.pinterest.at/*",
        "*://*.pinterest.ch/*",
        "*://*.pinterest.co.uk/*",
        "*://*.pinterest.fr/*",
        "*://*.pinterest.es/*",
        "*://*.pinterest.it/*",
        "*://*.pinterest.nl/*",
        "*://*.pinterest.se/*",
        "*://*.pinterest.dk/*",
        "*://*.pinterest.pt/*",
        "*://*.pinterest.ie/*",
        "*://*.pinterest.ca/*",
        "*://*.pinterest.com.au/*",
        "*://*.pinterest.nz/*",
        "*://*.pinterest.com.mx/*"
      ],
      "js": ["content/cleaner.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "*://*.pinterest.com/*",
        "*://*.pinterest.de/*",
        "*://*.pinterest.at/*",
        "*://*.pinterest.ch/*",
        "*://*.pinterest.co.uk/*",
        "*://*.pinterest.fr/*",
        "*://*.pinterest.es/*",
        "*://*.pinterest.it/*",
        "*://*.pinterest.nl/*",
        "*://*.pinterest.se/*",
        "*://*.pinterest.dk/*",
        "*://*.pinterest.pt/*",
        "*://*.pinterest.ie/*",
        "*://*.pinterest.ca/*",
        "*://*.pinterest.com.au/*",
        "*://*.pinterest.nz/*",
        "*://*.pinterest.com.mx/*"
      ],
      "js": ["content/bridge.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
